# Copy this file to .env and fill in real values. .env is gitignored.

# --- Postgres (application database) ---
POSTGRES_PASSWORD=changeme

# --- Postgres (Keycloak's own database) ---
KEYCLOAK_DB_PASSWORD=changeme

# --- Keycloak admin console login ---
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=changeme

# --- Public-facing URLs ---
# These must match whatever address the browser actually uses to reach
# Keycloak/the frontend. For local docker-compose testing, the defaults
# below (matching the ports published in docker-compose.prod.yml) work as-is.
# When deploying publicly, these become your HTTPS domains (set up in a
# later step alongside Caddy + DuckDNS).
OIDC_AUTHORITY=http://localhost:9090/realms/event-ticket-platform
OIDC_CLIENT_ID=event-ticket-platform-app
OIDC_REDIRECT_URI=http://localhost:8081/callback
